<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="02-create-users-table" author="Зайцев Тимофей">
        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>

        <createTable tableName="users">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(70)">
                <constraints nullable="false"/>
            </column>
            <column name="is_online" type="BOOLEAN"/>
            <column name="mail" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="verified" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)"/>
            <column name="surname" type="VARCHAR(50)"/>
            <column name="city_id" type="UUID"/>
            <column name="quote" type="VARCHAR(30)"/>
            <column name="avatar_url" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>